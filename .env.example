# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=gamingplace

# Database TLS: leave unset/0 for local MySQL; hosted databases may require TLS.
# DB_SSL=1
# DB_SSL_CA=/path/to/ca-certificates.crt
# DB_SSL_CERT=
# DB_SSL_KEY=

# CodeIgniter environment
CI_ENV=development

# PayPal Express Checkout
# Use sandbox credentials for testing. Never commit real credentials.
PAYPAL_MODE=sandbox
PAYPAL_API_USERNAME=
PAYPAL_API_PASSWORD=
PAYPAL_API_SIGNATURE=
